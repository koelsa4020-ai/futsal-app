rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function teamRef() { return /databases/$(database)/documents/settings/team; }
    function team() { return get(teamRef()).data; }
    function isPres() {
      return authed() && exists(teamRef()) && team().get('presidentUid', null) == request.auth.uid;
    }
    function isMgr() {
      return authed() && exists(teamRef())
        && (team().get('presidentUid', null) == request.auth.uid
            || request.auth.uid in team().get('managerUids', []));
    }
    function sameRoles() {
      return request.resource.data.get('managerUids', []) == resource.data.get('managerUids', [])
        && request.resource.data.get('presidentUid', null) == resource.data.get('presidentUid', null);
    }
    function meRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function joined() { return authed() && exists(meRef()); }
    function isMember() { return joined() || isMgr(); }
    function myPid() { return get(meRef()).data.pid; }

    // 팀 설정: 로그인한 사람은 읽기.
    // 회장: 매니저 지정/해제 포함 모두 수정. 매니저: 팀 이름만(역할 변경 불가).
    // 회장이 없을 때는 매니저가 자기 자신을 회장으로 등록 가능. 아무도 없는 팀은 첫 가입자가 회장.
    match /settings/team {
      allow read: if authed();
      allow create: if authed() && request.resource.data.managerUids == [request.auth.uid]
        && request.resource.data.presidentUid == request.auth.uid;
      allow update: if isPres()
        || (isMgr() && sameRoles())
        || (isMgr() && resource.data.get('presidentUid', null) == null
            && request.resource.data.presidentUid == request.auth.uid
            && request.resource.data.get('managerUids', []) == resource.data.get('managerUids', []))
        || (authed() && resource.data.get('managerUids', []).size() == 0
            && resource.data.get('presidentUid', null) == null
            && request.resource.data.managerUids == [request.auth.uid]
            && request.resource.data.presidentUid == request.auth.uid);
      allow delete: if false;
    }

    // 구글 계정 ↔ 선수 연결: 본인은 자기 계정이 연결된 선수로만 가입 가능.
    match /users/{uid} {
      allow read: if isMember() || (authed() && request.auth.uid == uid);
      allow create, update: if isMgr()
        || (authed() && request.auth.uid == uid
            && get(/databases/$(database)/documents/players/$(request.resource.data.pid)).data.get('uid', null) == request.auth.uid);
      allow delete: if isMgr();
    }

    // 선수: 가입할 때 자기 계정으로 새로 만들거나, 아직 연결 안 된 예전 기록을 이어받기.
    match /players/{id} {
      allow read: if authed();
      allow create: if isMgr() || (authed() && request.resource.data.get('uid', null) == request.auth.uid);
      allow update: if isMgr()
        || (authed() && request.resource.data.get('uid', null) == request.auth.uid
            && resource.data.get('uid', null) in [null, request.auth.uid]);
      allow delete: if isMgr();
    }

    // 투표 일정·용병·팀 짜기: 매니저만. 멤버는 보기만.
    match /weeks/{id} {
      allow read: if isMember();
      allow create, update, delete: if isMgr();
    }

    // 참석 투표: 본인 것만, 매니저는 모두.
    match /votes/{id} {
      allow read: if isMember();
      allow create, update: if isMgr()
        || (joined() && request.resource.data.pid == myPid()
            && id == request.resource.data.week + '__' + myPid());
      allow delete: if isMgr();
    }

    // 경기 기록: 매니저만. 멤버는 보기만.
    match /matches/{id} {
      allow read: if isMember();
      allow create, update, delete: if isMgr();
    }

    // 평가: 본인 이름으로만.
    match /ratings/{id} {
      allow read: if isMember();
      allow create, update: if joined() && request.resource.data.rater == myPid()
        && id == request.resource.data.match + '__' + myPid();
      allow delete: if isMgr();
    }
  }
}
